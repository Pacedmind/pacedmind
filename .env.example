# Copy to .env.local for `npm run dev`. Without it the app uses PacedMind's own Supabase project, like the
# desktop app does.

# The Supabase project with PacedMind's data (Project Settings > API keys, or the Connect button).
# Both values are public: row level security, with two-factor sessions, decides what anyone can see.
# For local development, `npx supabase start` prints a local URL (http://127.0.0.1:54321) and key.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# desktop (the default): one signed-in account per server; agents, terminals and MCP on this computer.
# web: the hosted app. Every browser signs in on its own; it never starts agents, it asks a desktop app to.
# ORGANIZER_MODE=web

# The hosted app's own address (web mode, required there). Email links point at it, and requests for any
# other host are refused. Its MCP server (PacedMind Cloud's) is this address plus /api/mcp.
# ORGANIZER_PUBLIC_ORIGIN=https://app.pacedmind.com

# Exact public domain-verification token from OpenAI's plugin submission portal. Web mode only:
# served as plain text at /.well-known/openai-apps-challenge. Leave unset until the portal issues it.
# ORGANIZER_OPENAI_APPS_CHALLENGE=

# Desktop mode with a local stack: where PacedMind Cloud's MCP server is, for Settings → Connect (a web-mode server of
# your own). Defaults to https://app.pacedmind.com.
# ORGANIZER_CLOUD_ORIGIN=http://127.0.0.1:4321

# Never put a Supabase secret or service-role key here: the app doesn't use one anywhere. (Only the billing webhook,
# an Edge Function in Supabase, does; its secrets live in Supabase: npx supabase secrets set.)

# Optional Google Calendar integration. Enable Calendar API and create an OAuth client in Google Cloud.
# Web client redirects: https://app.pacedmind.com/api/google-calendar/callback (or your public origin).
# Development redirect: http://127.0.0.1:4320/api/google-calendar/callback.
# Desktop redirect: http://127.0.0.1:4319/api/google-calendar/callback (Desktop OAuth client + PKCE).
# Use separate clients for web and installed apps; a public desktop client may omit the secret.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Web requires a persistent 32-byte base64 encryption key. Desktop uses its OS-keychain data key.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GOOGLE_CALENDAR_ENCRYPTION_KEY=
